# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage-*
coverage.xml
htmlcov/
.venv/
venv/
pytest-of-*/
data-gym-cache/

# jieba writes its dictionary cache next to the working directory on first use.
jieba.cache
jiebacache

# Environment and local databases
.env
*.db
*.sqlite3
data/uploads/*
!data/uploads/.gitkeep

# Prepared knowledge-base corpus, staged here until it is uploaded
data-staging/
corpus-runtime/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local scratch files
*.tmp
.commit-msg*.tmp
# Sandboxed tool caches (ruff/black/coverage) redirected into the workspace
.tmp-session/

# pre-commit cache when redirected into the workspace
.pre-commit-cache/

# Runtime scratch: encoder build caches, the fallback temporary directory, the
# uploads staged for indexing, logs, the pip HTTP cache and the one-off
# diagnostic scripts written while debugging. All of it is regenerated and the
# directory runs into hundreds of megabytes, so it is ignored as a whole instead
# of path by path; project-local placement is what keeps the encoder off the
# system temporary directory.
.runtime/

# Sandbox/agent ACL audit reports, written by the harness rather than the project
.dsh-acl-reports/
