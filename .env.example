APP_NAME=Network RAG
APP_ENV=development
APP_DEBUG=false
DATABASE_URL=sqlite:///./network_rag.db
DOCUMENT_UPLOAD_DIR=data/uploads
DOCUMENT_MAX_UPLOAD_BYTES=52428800
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-an-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
FRONTEND_ORIGIN=http://127.0.0.1:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=network_rag_access_token
AUTH_COOKIE_SECURE=false

# Retrieval quality and prompt budget
RETRIEVAL_MIN_SCORE=0.87
CHAT_HISTORY_TURNS=3
CHAT_HISTORY_MAX_TOKENS=512

# Generation
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=1024

# Indexing lease and in-process request limits
INDEXING_LEASE_SECONDS=900
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
CHAT_MAX_REQUESTS=30
CHAT_WINDOW_SECONDS=60

# Optional: where the encoder writes its build cache. Left unset it resolves to
# <project root>/.runtime/cache, which keeps the encoder off the system
# temporary directory.
# EMBEDDING_CACHE_DIR=

# Optional: read the embedding model from the local Hugging Face cache without
# contacting huggingface.co. Defaults to true in code; set false only when the
# cache is incomplete and the Hub is reachable. Also accepts HF_ENDPOINT for a
# mirror.
# EMBEDDING_OFFLINE=true
